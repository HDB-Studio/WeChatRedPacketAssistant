<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="雙步點擊"
            android:textColor="#212121"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="設定兩個依序執行的點擊動作，由你手動觸發。"
            android:textColor="#616161"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="無障礙服務：未開啟"
            android:textColor="#D32F2F"
            android:textSize="14sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnOpenSettings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="① 開啟無障礙服務設定" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="目標 App 套件名稱（可留空 = 不限制）"
            android:textColor="#424242"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/etTarget"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="例如 com.example.myapp"
            android:inputType="text"
            android:textSize="14sp" />

        <!-- 步驟 1 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="步驟 1"
            android:textColor="#212121"
            android:textSize="16sp"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/rg1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/rb1Text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="文字" />

            <RadioButton
                android:id="@+id/rb1Desc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="描述" />

            <RadioButton
                android:id="@+id/rb1Id"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="viewId" />

            <RadioButton
                android:id="@+id/rb1Point"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="座標" />
        </RadioGroup>

        <EditText
            android:id="@+id/etValue1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="要點擊的文字 / 描述 / viewId"
            android:inputType="text"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/etX1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="X %"
                android:inputType="number"
                android:text="50"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/etY1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Y %"
                android:inputType="number"
                android:text="50"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/etWait1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="等待 ms"
                android:inputType="number"
                android:text="500"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- 步驟 2 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="步驟 2"
            android:textColor="#212121"
            android:textSize="16sp"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/rg2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/rb2Text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="文字" />

            <RadioButton
                android:id="@+id/rb2Desc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="描述" />

            <RadioButton
                android:id="@+id/rb2Id"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="viewId" />

            <RadioButton
                android:id="@+id/rb2Point"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="座標" />
        </RadioGroup>

        <EditText
            android:id="@+id/etValue2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="要點擊的文字 / 描述 / viewId"
            android:inputType="text"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/etX2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="X %"
                android:inputType="number"
                android:text="50"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/etY2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Y %"
                android:inputType="number"
                android:text="50"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/etWait2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="等待 ms"
                android:inputType="number"
                android:text="800"
                android:textSize="14sp" />
        </LinearLayout>

        <Button
            android:id="@+id/btnSave"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="② 儲存設定" />

        <Button
            android:id="@+id/btnNotify"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="③ 顯示執行通知（切到目標 App 後點它）" />

        <Button
            android:id="@+id/btnRun"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="在本頁立即測試執行" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:lineSpacingExtra="3dp"
            android:text="用法：設定步驟 → 儲存 → 顯示執行通知 → 切換到目標 App，下拉通知欄點「執行」。\n\n座標為螢幕百分比（50 = 正中央），與解析度無關。"
            android:textColor="#757575"
            android:textSize="12sp" />

    </LinearLayout>
</ScrollView>
